{
  "testEnvironment": "jsdom",
  "testMatch": ["**/__tests__/**/*.test.js"],
  "verbose": true,
  "rootDir": ".",
  "collectCoverageFrom": [
    "js/**/*.js",
    "!js/dist/**",
    "!js/vendor/**",
    "!js/icons.js"
  ],
  "coverageReporters": ["text", "lcov"],
  "coverageThreshold": {
    "global": {
      "statements": 95,
      "branches": 85,
      "functions": 95,
      "lines": 95
    },
    "./js/**/*.js": {
      "statements": 80,
      "branches": 60,
      "functions": 80,
      "lines": 80
    }
  }
}
