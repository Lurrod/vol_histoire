{
  "name": "vol-histoire",
  "version": "4.32.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "e2e": "cd e2e && npm test",
    "e2e:headed": "cd e2e && npm run test:headed",
    "build:js": "node scripts/build-js.js",
    "build:css": "node scripts/build-css.js",
    "build": "node scripts/build-js.js && node scripts/build-css.js",
    "check:release": "node scripts/check-release.js",
    "lint": "eslint backend/ frontend/js/ scripts/ e2e/ --max-warnings=0",
    "lint:fix": "eslint backend/ frontend/js/ scripts/ e2e/ --max-warnings=0 --fix",
    "test:all": "cd backend && npm run test:coverage && cd ../e2e && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "sharp": "^0.35.5"
  }
}
