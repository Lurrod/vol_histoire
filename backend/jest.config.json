{
  "testEnvironment": "node",
  "testMatch": ["**/__tests__/**/*.test.js"],
  "collectCoverageFrom": [
    "**/*.js",
    "!**/__tests__/**",
    "!db_backup/**",
    "!migrations/**",
    "!coverage/**",
    "!node_modules/**",
    "!jest-resolver.js"
  ],
  "coverageReporters": ["text", "lcov"],
  "coverageThreshold": {
    "global": {
      "statements": 80,
      "branches": 80,
      "functions": 80,
      "lines": 80
    }
  },
  "verbose": true,
  "resolver": "./jest-resolver.js"
}
