# =============================================================================
# Vol d'Histoire — variables d'environnement du backend
# Copier en backend/.env (jamais versionné) et remplir. Les valeurs ci-dessous
# sont factices. Liste tenue à jour d'après le code :
#   grep -rhoE "process\.env\.[A-Z_]+" backend --include=*.js \
#     --exclude-dir=node_modules --exclude-dir=__tests__ | sort -u
# =============================================================================

# ── Environnement ────────────────────────────────────────────────────────────
# OBLIGATOIRE EN PRODUCTION : NODE_ENV=production. Sans lui, et sans aucune
# erreur au démarrage : cookies de session sans l'attribut Secure, /api/docs
# (Swagger) exposé, /api/metrics accessible sans METRICS_TOKEN, et MAIL_*
# non exigés. Valeurs : production | development | test (test = limiteur de
# débit et Redis désactivés, mailer muet — réservé à Jest et aux E2E).
# NODE_ENV=production

# ── Base de données PostgreSQL (obligatoires) ────────────────────────────────
DB_USER=vol_user
DB_HOST=localhost
DB_NAME=vol_histoire
DB_PASSWORD=change-me
DB_PORT=5432
# false     : connexion sans TLS (base locale, socket ou 127.0.0.1)
# no-verify : TLS sans vérification du certificat (certificat auto-signé)
# true      : TLS avec vérification complète (valeur par défaut si absente)
DB_SSL=false

# ── Jetons (obligatoires, 32 caractères minimum, le serveur refuse sinon) ────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer-par-64-octets-aleatoires-en-hexadecimal-0000000000000000
REFRESH_SECRET=remplacer-par-64-octets-aleatoires-en-hexadecimal-1111111111111111

# ── Email (OVH) ──────────────────────────────────────────────────────────────
# Le serveur SMTP est fixé dans mailer.js : ssl0.ovh.net:465 (SSL/TLS). Seuls
# l'identifiant et le mot de passe se règlent ici (il n'y a PAS de SMTP_*).
# Obligatoires en production (arrêt au démarrage s'ils manquent) ; absents en
# dev, le mailer passe en mode muet (aucun envoi, avertissement dans les logs).
MAIL_USER=noreply@example.com
MAIL_PASS=change-me
# Destinataire du formulaire de contact. Défaut : MAIL_USER.
# CONTACT_EMAIL=contact@example.com

# ── Frontend et serveur ──────────────────────────────────────────────────────
# Base des liens envoyés par email (vérification, réinitialisation…). En local,
# le site est servi par le backend lui-même (en-tête et pied inclus par
# serveHtml) : même port que PORT.
FRONTEND_URL=http://localhost:3000
PORT=3000
# Interface d'écoute. Défaut 127.0.0.1 : seul Apache est exposé. 0.0.0.0 = toutes les interfaces.
# HOST=127.0.0.1
# Origines autorisées (CORS + contrôle d'Origin des requêtes d'écriture),
# séparées par des virgules. En production : https://vol-histoire.titouan-borde.com
# En local, l'origine du site servi par le backend (sinon les écritures et
# /api/refresh répondent 403 « Origine non autorisée »).
ALLOWED_ORIGINS=http://localhost:3000

# ── hCaptcha (inscription, mot de passe oublié, contact) ─────────────────────
# Sans HCAPTCHA_SECRET, la vérification est SAUTÉE (tout passe) : à renseigner
# en production. La clé de site est publique (renvoyée par /api/config).
# HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
# HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# ── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | debug (défaut : info)
LOG_LEVEL=info

# ── Sentry (optionnel, backend) ──────────────────────────────────────────────
# Sans SENTRY_DSN, Sentry n'est pas chargé. Jamais actif sous NODE_ENV=test.
# SENTRY_DSN=https://cle-publique@o0.ingest.sentry.io/0
# Défaut : NODE_ENV, puis « production ».
# SENTRY_ENVIRONMENT=production
# Identifiant de release (ex. vol-histoire@4.13.1). Défaut : non renseigné.
# SENTRY_RELEASE=vol-histoire@0.0.0
# Proportion de transactions tracées, entre 0 et 1 (défaut : 0.1).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# true = envoyer aussi les avertissements (défaut : erreurs seulement).
# SENTRY_CAPTURE_WARN=false

# ── Redis (optionnel) ────────────────────────────────────────────────────────
# Active le rate-limit et le cache applicatif partagés entre instances.
# Sans REDIS_URL : repli en mémoire (OK pour une instance unique / dev).
# REDIS_URL=redis://localhost:6379

# ── Monitoring ───────────────────────────────────────────────────────────────
# Jeton Bearer de /api/metrics et /api/status. Obligatoire en production
# (sans lui, /api/metrics répond 403).
# METRICS_TOKEN=change-me

# ── Divers ───────────────────────────────────────────────────────────────────
# CI=true (posé automatiquement par GitHub Actions) met aussi le mailer en mode
# muet. Ne pas le définir à la main.
